# Copy to functions/.secret.local. Never commit the populated file.
REVENUECAT_SECRET_API_KEY=sk_replace_me
# The remaining values are optional for the first purchase + explicit refresh run.
# Replace them before account-deletion or webhook tests.
REVENUECAT_V2_SECRET_API_KEY=local_not_configured
REVENUECAT_WEBHOOK_AUTHORIZATION=local_not_configured
REVENUECAT_WEBHOOK_SIGNING_SECRET=local_not_configured
REVENUECAT_ALLOWED_APP_IDS=local_not_configured
