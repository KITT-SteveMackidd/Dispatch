{
  "name": "dispatch",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "expo:compatibility": "node scripts/check-expo-go-compatibility.mjs",
    "expo:verify": "node scripts/check-expo-go-compatibility.mjs --url http://127.0.0.1:8083",
    "prestart": "npm run expo:compatibility",
    "preios": "npm run expo:compatibility",
    "preandroid": "npm run expo:compatibility",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "postinstall": "patch-package",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project dispatch-rules-test \"node --test tests/firestore-rules.node.mjs\"",
    "test:android-beta-rules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-android-beta-rules.ps1",
    "test:existing-customer-workers": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-existing-customer-workers.ps1",
    "android:customer:check": "node scripts/check-android-beta-config.mjs android-customer-beta",
    "ios:customer:check": "node scripts/check-android-beta-config.mjs ios-customer-beta",
    "android:billing:check": "node scripts/check-android-beta-config.mjs android-billing-qa",
    "check": "npm run expo:compatibility && expo install --check && npm run typecheck && npm run test",
    "billing:test:check": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-billing-test-config.ps1",
    "billing:test:rules": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-billing-test-rules.ps1",
    "billing:test:harness": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/check-billing-test-harness.ps1",
    "billing:test:emulators": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-billing-test-emulators.ps1",
    "billing:test:seed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/seed-billing-test.ps1",
    "billing:test:expo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-billing-test-expo.ps1"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@js-temporal/polyfill": "^0.5.1",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~58.0.21",
    "expo-apple-authentication": "~58.0.2",
    "expo-auth-session": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-calendar": "~58.0.6",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.7",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-notifications": "~58.1.7",
    "expo-router": "~58.0.28",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "expo-web-browser": "~58.0.7",
    "firebase": "^12.9.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "10.7.2",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "rrule": "^2.8.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/react": "~19.3.0",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9",
    "@expo/ngrok": "^4.1.3"
  },
  "private": true
}
