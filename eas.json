{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "autoIncrement": true
    },
    "beta": {
      "distribution": "store",
      "channel": "beta",
      "environment": "preview",
      "autoIncrement": true,
      "ios": {
        "image": "sdk-58"
      },
      "android": {
        "image": "sdk-58",
        "buildType": "app-bundle"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "beta": {
      "ios": {
        "ascAppId": "6799206233"
      },
      "android": {
        "track": "internal",
        "releaseStatus": "draft"
      }
    },
    "production": {
      "ios": {
        "ascAppId": "6799206233"
      }
    }
  }
}
