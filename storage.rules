rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function authenticated() {
      return request.auth != null;
    }

    function userProfileExists() {
      return authenticated()
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userProfile() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function canReadDispatchStorage() {
      return userProfileExists()
        && !('accountDeletionStartedAt' in userProfile().data);
    }

    function isCustomerBetaProject() {
      return authenticated() && request.auth.token.aud == 'dispatch-customer-beta';
    }

    function customerBetaAccessEnabled() {
      return firestore.exists(/databases/(default)/documents/dispatchConfig/billing)
        && firestore.get(/databases/(default)/documents/dispatchConfig/billing).data.mode == 'customer_beta'
        && firestore.get(/databases/(default)/documents/dispatchConfig/billing).data.projectId == request.auth.token.aud;
    }

    function organizationStorageWriteEnabled(organizationId) {
      return organizationId is string
        // Branch before the document read: Storage permits only two distinct
        // Firestore reads (thread/profile plus policy OR organization billing).
        && (isCustomerBetaProject() ? customerBetaAccessEnabled() : (
          firestore.exists(/databases/(default)/documents/organizationBilling/$(organizationId))
          && (
          !('accessMode' in firestore.get(/databases/(default)/documents/organizationBilling/$(organizationId)).data)
          || firestore.get(/databases/(default)/documents/organizationBilling/$(organizationId)).data.accessMode != 'read_only'
          )
        ));
    }

    function participatesInExplicitOrganizationChat(threadId) {
      return firestore.exists(/databases/(default)/documents/chatThreads/$(threadId))
        && firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.organizationId is string
        && firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.participants is list
        && request.auth.uid in firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.participants;
    }

    function canReadChat(threadId) {
      return canReadDispatchStorage()
        && participatesInExplicitOrganizationChat(threadId)
        && userProfile().data.organizationId
          == firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.organizationId;
    }

    function legacyChatUploadsEnabled(organizationId) {
      return isCustomerBetaProject()
        || firestore.get(/databases/(default)/documents/organizationBilling/$(organizationId)).data.get('chatSafetyEnabled', false) != true;
    }

    function canMutateChat(threadId) {
      // Storage Rules may access at most two Firestore documents. Mutations use
      // the explicit thread (participation) plus authoritative billing state;
      // member-removal/account-deletion cleanup strips stale participants, and
      // the finalizer reaps any race or legacy organization mismatch.
      return authenticated()
        && participatesInExplicitOrganizationChat(threadId)
        && legacyChatUploadsEnabled(firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.organizationId)
        && (!isCustomerBetaProject()
          || !('organizationRecoveryState' in firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data)
          || firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.organizationRecoveryState != 'orphaned_no_manager')
        && organizationStorageWriteEnabled(
          firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.organizationId
        );
    }

    match /dispatchTemplateAttachments/{ownerId}/{allPaths=**} {
      allow get: if canReadDispatchStorage() && request.auth.uid == ownerId;
      allow list: if false;
      allow create: if canReadDispatchStorage()
        && request.auth.uid == ownerId
        && (!isCustomerBetaProject()
          || !('organizationRecoveryState' in userProfile().data)
          || userProfile().data.organizationRecoveryState != 'orphaned_no_manager')
        && organizationStorageWriteEnabled(userProfile().data.organizationId);
      // This legacy path has no immutable organization segment. Client-side
      // replacement/deletion could otherwise mutate an old organization's
      // retained attachment after the owner joins a different organization.
      allow update, delete: if false;
    }

    match /chatAttachments/{threadId}/{ownerId}/{allPaths=**} {
      allow get: if canReadChat(threadId);
      allow list: if false;
      allow create, update, delete: if canMutateChat(threadId)
        && request.auth.uid == ownerId
        && request.auth.uid in firestore.get(/databases/(default)/documents/chatThreads/$(threadId)).data.participants;
    }

    function chatUploadGrant(grantId) {
      return firestore.get(/databases/(default)/documents/chatUploadGrants/$(grantId)).data;
    }

    function canCreateSecureChatUpload(grantId, filename) {
      let grant = chatUploadGrant(grantId);
      let profile = userProfile().data;
      let legacy = profile.get('chatSuspension', {});
      let restriction = legacy.get('active', false) == true && legacy.get('organizationId', null) == null
        ? legacy : profile.get('chatOrganizationSuspensions', {}).get(profile.get('organizationId', ''), legacy);
      // Exactly two Firestore documents: server grant and current owner profile.
      return authenticated() && grant.ownerId == request.auth.uid
        && grant.objectPath == 'chatSafetyAttachments/' + grantId + '/' + filename
        && grant.expiresAt > request.time && !('usedAt' in grant)
        && profile.organizationId == grant.organizationId
        && !('accountDeletionStartedAt' in profile)
        && profile.get('chatRulesVersion', '') == '2026-10-27'
        && (restriction.get('active', false) != true
          || (restriction.get('organizationId', null) != null && restriction.organizationId != profile.organizationId)
          || (restriction.get('expiresAt', null) is timestamp && restriction.expiresAt <= request.time))
        && request.resource.size == grant.size && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType == grant.mimeType;
    }

    match /chatSafetyAttachments/{grantId}/{filename} {
      allow create: if canCreateSecureChatUpload(grantId, filename);
      allow update, delete, list: if false;
      allow get: if authenticated() && (
        chatUploadGrant(grantId).ownerId == request.auth.uid
        || ('usedAt' in chatUploadGrant(grantId)
          && participatesInExplicitOrganizationChat(chatUploadGrant(grantId).threadId))
      );
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
