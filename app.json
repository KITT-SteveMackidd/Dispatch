{
  "expo": {
    "name": "dispatch",
    "slug": "dispatch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dispatch",
    "splash": {
      "image": "./assets/images/dispatch-splash-full.png",
      "resizeMode": "contain",
      "backgroundColor": "#06132a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#06132a",
        "foregroundImage": "./assets/images/android-icon-foreground-dispatch.png",
        "monochromeImage": "./assets/images/android-icon-monochrome-dispatch.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
