rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocAfter() {
      return getAfter(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return userDocExists() ? userDoc().data.role : null;
    }

    function userOrganizationId() {
      return userDocExists() ? userDoc().data.organizationId : null;
    }

    function isManager() {
      return signedIn() && userRole() in ['manager', 'Manager'];
    }

    function isManagerAfterWrite() {
      return signedIn() && userDocAfter().data.role in ['manager', 'Manager'];
    }

    function isEventOwner(eventId) {
      return signedIn()
        && eventId is string
        && exists(/databases/$(database)/documents/events/$(eventId))
        && get(/databases/$(database)/documents/events/$(eventId)).data.managerId == request.auth.uid;
    }

    function teamDoc(teamId) {
      return get(/databases/$(database)/documents/teams/$(teamId));
    }

    function teamDocExists(teamId) {
      return exists(/databases/$(database)/documents/teams/$(teamId));
    }

    function isTeamManager(teamId) {
      return signedIn() && teamDocExists(teamId) && teamDoc(teamId).data.managerId == request.auth.uid;
    }

    function isOrganizationManager(organizationId) {
      return isManager()
        && organizationId is string
        && userOrganizationId() == organizationId;
    }

    function isOrganizationMember(organizationId) {
      return signedIn()
        && organizationId is string
        && userOrganizationId() == organizationId;
    }

    function acceptedWorkerInviteForTeam(teamId) {
      return signedIn()
        && request.resource.data.lastAcceptedInviteId is string
        && getAfter(/databases/$(database)/documents/workerInvites/$(request.resource.data.lastAcceptedInviteId)).data.workerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/workerInvites/$(request.resource.data.lastAcceptedInviteId)).data.teamId == teamId
        && getAfter(/databases/$(database)/documents/workerInvites/$(request.resource.data.lastAcceptedInviteId)).data.status == 'accepted';
    }

    function acceptedWorkerInviteForOrganization(organizationId) {
      return signedIn()
        && request.resource.data.lastAcceptedInviteId is string
        && getAfter(/databases/$(database)/documents/workerInvites/$(request.resource.data.lastAcceptedInviteId)).data.workerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/workerInvites/$(request.resource.data.lastAcceptedInviteId)).data.organizationId == organizationId
        && getAfter(/databases/$(database)/documents/workerInvites/$(request.resource.data.lastAcceptedInviteId)).data.status == 'accepted';
    }

    function isInviteManager() {
      return signedIn() && resource.data.managerId == request.auth.uid;
    }

    function workerOwnsInvite() {
      return signedIn()
        && (
          (resource.data.workerId != null && resource.data.workerId == request.auth.uid)
          || (
            resource.data.claimRequired != true
            && request.auth.token.email != null
            && (
              resource.data.email == request.auth.token.email
              || resource.data.normalizedEmail == request.auth.token.email
            )
          )
        );
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isSameOrganizationProfile() {
      return signedIn()
        && userOrganizationId() is string
        && resource.data.organizationId == userOrganizationId();
    }

    function validInviteStatus(status) {
      return status in ['created', 'delivery_queued', 'delivered', 'delivery_failed', 'pending_acceptance', 'accepted', 'declined', 'expired', 'revoked', 'cancelled'];
    }

    function missingOrNull(fieldName) {
      return !(fieldName in request.resource.data) || request.resource.data[fieldName] == null;
    }

    match /users/{userId} {
      allow read: if isSelf(userId) || isSameOrganizationProfile();
      allow create: if isSelf(userId);
      allow update: if isSelf(userId)
        || (
          isManager()
          && userOrganizationId() is string
          && resource.data.organizationId == userOrganizationId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['organizationId', 'organizationName', 'updatedAt'])
          && request.resource.data.organizationId == null
          && request.resource.data.organizationName == null
        );
      allow delete: if isSelf(userId);
    }

    match /teams/{teamId} {
      allow read: if signedIn()
        && (
          resource.data.managerId == request.auth.uid
          || (resource.data.managerIds is list && request.auth.uid in resource.data.managerIds)
          || isOrganizationManager(resource.data.organizationId)
          || isOrganizationMember(resource.data.organizationId)
          || (resource.data.workerIds is list && request.auth.uid in resource.data.workerIds)
        );

      allow create: if isManager()
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.workerIds is list
        && request.resource.data.workerIds.size() == 0;

      allow update: if isTeamManager(teamId)
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.workerIds is list
      || (
        isOrganizationManager(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerId', 'managerIds', 'updatedAt'])
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.managerIds is list
        && request.resource.data.managerIds.size() > 0
        && request.resource.data.managerId in request.resource.data.managerIds
      )
      || (
        isOrganizationManager(resource.data.organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerIds', 'managerIds', 'updatedAt'])
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.workerIds is list
        && request.resource.data.managerIds is list
        && request.resource.data.managerIds.hasAll(resource.data.managerIds)
        && request.auth.uid in request.resource.data.managerIds
      )
      || (
        acceptedWorkerInviteForTeam(teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerIds', 'lastAcceptedInviteId', 'updatedAt'])
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.workerIds is list
        && request.resource.data.workerIds.hasAll(resource.data.workerIds)
        && request.auth.uid in request.resource.data.workerIds
      )
      || (
        signedIn()
        && request.auth.uid in resource.data.workerIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerIds', 'updatedAt'])
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.workerIds is list
        && resource.data.workerIds.hasAll(request.resource.data.workerIds)
        && !(request.auth.uid in request.resource.data.workerIds)
        && request.resource.data.workerIds.size() == resource.data.workerIds.size() - 1
      );

      allow delete: if isTeamManager(teamId) || isOrganizationManager(resource.data.organizationId);
    }

    match /organizations/{organizationId} {
      allow read: if signedIn()
        && (
          userOrganizationId() == organizationId
          || (resource.data.managerIds is list && request.auth.uid in resource.data.managerIds)
          || (resource.data.workerIds is list && request.auth.uid in resource.data.workerIds)
        );

      allow create: if isManager()
        && request.auth.uid in request.resource.data.managerIds
        && request.resource.data.createdBy == request.auth.uid
      || (
        isManagerAfterWrite()
        && request.auth.uid in request.resource.data.managerIds
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.workerIds is list
        && request.resource.data.workerIds.size() == 0
      );

      allow update: if isOrganizationManager(organizationId)
        && request.resource.data.managerIds is list
        && request.resource.data.workerIds is list
      || (
        acceptedWorkerInviteForOrganization(organizationId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerIds', 'lastAcceptedInviteId', 'updatedAt'])
        && request.resource.data.managerIds == resource.data.managerIds
        && request.resource.data.workerIds is list
        && request.resource.data.workerIds.hasAll(resource.data.workerIds)
        && request.auth.uid in request.resource.data.workerIds
        && request.resource.data.workerIds.size() == resource.data.workerIds.size() + 1
      )
      || (
        isManager()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerIds', 'updatedAt'])
        && resource.data.pendingManagerInviteEmails is list
        && request.auth.token.email in resource.data.pendingManagerInviteEmails
        && !(request.auth.uid in resource.data.managerIds)
        && request.auth.uid in request.resource.data.managerIds
        && request.resource.data.managerIds.hasAll(resource.data.managerIds)
        && request.resource.data.managerIds.size() == resource.data.managerIds.size() + 1
      ) || (
        signedIn()
        && request.auth.uid in resource.data.workerIds
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerIds', 'updatedAt'])
        && request.resource.data.managerIds == resource.data.managerIds
        && request.resource.data.workerIds is list
        && resource.data.workerIds.hasAll(request.resource.data.workerIds)
        && !(request.auth.uid in request.resource.data.workerIds)
        && request.resource.data.workerIds.size() == resource.data.workerIds.size() - 1
      );

      allow delete: if isOrganizationManager(organizationId)
        && resource.data.managerIds is list
        && resource.data.managerIds.size() == 1
        && request.auth.uid in resource.data.managerIds;
    }

    match /workerInvites/{inviteId} {
      allow read: if isInviteManager() || workerOwnsInvite();

      allow create: if isManager()
        && request.resource.data.managerId == request.auth.uid
        && validInviteStatus(request.resource.data.status)
        && request.resource.data.expiresAt is timestamp
        && missingOrNull('consumedAt')
        && missingOrNull('inviteTokenId');

      allow update: if (
        isInviteManager()
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.email == resource.data.email
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.workerId == resource.data.workerId
        && validInviteStatus(request.resource.data.status)
      ) || (
        workerOwnsInvite()
        && validInviteStatus(request.resource.data.status)
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.email == resource.data.email
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.workerId == request.auth.uid
        && request.resource.data.status in ['pending_acceptance', 'accepted', 'declined']
      );
    }

    match /managerInvites/{inviteId} {
      allow read: if signedIn()
        && (
          resource.data.inviterId == request.auth.uid
          || (
            resource.data.claimRequired != true
            && (
              resource.data.email == request.auth.token.email
              || resource.data.normalizedEmail == request.auth.token.email
            )
          )
        );

      allow create: if isManager()
        && request.resource.data.inviterId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if (
        isManager()
        && resource.data.inviterId == request.auth.uid
        && request.resource.data.inviterId == resource.data.inviterId
        && request.resource.data.organizationId == resource.data.organizationId
      ) || (
        isManager()
        && resource.data.claimRequired != true
        && (
          resource.data.email == request.auth.token.email
          || resource.data.normalizedEmail == request.auth.token.email
        )
        && request.resource.data.organizationId == resource.data.organizationId
        && request.resource.data.status == 'accepted'
        && request.resource.data.managerUserId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerUserId', 'status', 'statusReason', 'acceptedAt', 'updatedAt'])
      );
    }

    match /inviteTokens/{inviteId} {
      allow read: if signedIn() && (
        resource.data.managerId == request.auth.uid
        || (resource.data.email == request.auth.token.email)
      );

      allow create: if isManager()
        && request.resource.data.inviteId == inviteId
        && request.resource.data.managerId == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.expiresAt is timestamp;

      allow update: if (
        signedIn()
        && resource.data.managerId == request.auth.uid
        && request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.email == resource.data.email
        && request.resource.data.status in ['active', 'expired', 'revoked', 'cancelled']
      ) || (
        signedIn()
        && request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.managerId == resource.data.managerId
        && request.resource.data.email == resource.data.email
        && request.resource.data.status == 'consumed'
        && resource.data.email == request.auth.token.email
      );
    }

    // Raw invitation tokens and fallback-code mappings are server-only. The
    // callable Functions expose a safe preview and perform authenticated claims.
    match /secureInvites/{inviteHash} {
      allow read, write: if false;
    }

    match /secureInviteCodes/{codeHash} {
      allow read, write: if false;
    }

    match /roleAssignmentNotifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.workerId == request.auth.uid
        || resource.data.managerId == request.auth.uid
        || (isManager() && isEventOwner(resource.data.eventId))
      );
      allow create: if isManager() && request.resource.data.managerId == request.auth.uid && request.resource.data.action == 'assign';
      allow update: if signedIn() && resource.data.workerId == request.auth.uid;
      allow delete: if isManager() && isEventOwner(resource.data.eventId);
    }

    match /userNotifications/{notificationId} {
      allow read: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (isManager() && isEventOwner(resource.data.relatedEventId))
      );
      allow create: if signedIn();
      allow update: if signedIn() && resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && (
        resource.data.userId == request.auth.uid
        || (isManager() && isEventOwner(resource.data.relatedEventId))
      );
    }

    match /chatThreads/{threadId} {
      allow read, write: if signedIn();
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
      match /activeViewers/{userId} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /chatUnread/{docId} {
      allow read, write: if signedIn();
    }

    match /eventTemplates/{templateId} {
      allow read, write: if signedIn();
    }

    match /events/{eventId} {
      allow read, write: if signedIn();
    }

    // Private beta checklist state. Each tester can access only their own run.
    match /dispatchBetaChecklistRuns/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /mail/{mailId} {
      allow create: if signedIn();
    }
  }
}
